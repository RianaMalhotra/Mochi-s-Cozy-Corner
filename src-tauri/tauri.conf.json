{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mochi's Cozy Corner",
  "version": "0.1.0",
  "identifier": "com.mochi.cozycorner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mochi's Cozy Corner",
        "width": 350,
        "height": 440,
        "minWidth": 350,
        "minHeight": 440,
        "maxWidth": 350,
        "maxHeight": 440,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
